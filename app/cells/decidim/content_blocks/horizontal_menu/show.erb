<section id="hero-menu-<%= model.id %>" class="bg-primary" data-controller="horizontal-menu">
  <!-- Mobile Menu Button -->
  <div class="md:hidden flex items-center justify-between px-4 py-4">
    <button
      data-horizontal-menu-target="toggle"
      data-action="click->horizontal-menu#toggle"
      class="text-white hover:text-secondary transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-secondary rounded-lg p-2"
      aria-expanded="false"
      aria-controls="menu-list-<%= model.id %>"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Navigation Container -->
  <nav
    id="menu-list-<%= model.id %>"
    data-horizontal-menu-target="menu"
    class="hidden md:block md:w-fit m-auto px-4 sm:px-6 lg:px-16"
    role="navigation"
    aria-label="<%= t('decidim.participatory_spaces.nav', default: 'Main navigation') %>"
  >
    <ul class="flex flex-col md:flex-row md:gap-10">
      <% published_components.each do |component| %>
        <li class="flex">
          <%= link_to translated_attribute(component.name), component_path(component),
              class: "py-4 lg:py-5 px-4 lg:px-6 font-semibold text-white hover:text-secondary lg:border-b-2 lg:border-transparent
                      lg:hover:border-secondary focus:ring-2 focus:ring-secondary transition-colors duration-150 w-full lg:w-auto block",
              data: { action: "click->horizontal-menu#close" }
          %>
        </li>
      <% end %>
    </ul>
  </nav>
</section>

<%= append_javascript_pack_tag "decidim_contagem", defer: false %>